---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Sidebar from "@/components/Sidebar.astro";
---

<Base>
  <div
    class="h-screen sm:w-3/4 max-w-4xl place-self-center flex flex-col"
    id="main-stage"
  >
    <Header />
    <main
      class="grid grid-cols-[250px_1fr] p-2 gap-4 grid-rows-1 h-full small-tr-big-bl-bevel"
      id="main-stage--content"
    >
      <Sidebar />
      <div class="content">Content</div>
    </main>
    <footer class="text-lg content-end text-center py-1">
      Swanson Digital Arts &copy; 2026
    </footer>
  </div>
</Base>
