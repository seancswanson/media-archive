---
import HomepageRouterLink from "./HomepageRouterLink.astro";

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<header class="mb-2 gap-2 flex flex-col">
  <div
    class="flex flex-col justify-between border-white border small-tr-big-bl-bevel title-bar-container"
  >
    <div class="flex border-white justify-between items-start">
      <h1 class="text-4xl font-bold mild-text-shadow pl-1">Media Archive</h1>
      <div
        class="flex gap-2 items-center small-bl-bevel user-container min-h-[25px] px-3 pl-6"
      >
        <img src="/icon-avatar.svg" alt="User" class="h-5 w-5 user-avatar" />
        <div class="username text-ellipsis">
          Testing123123123Testing12312312
        </div>
      </div>
    </div>
    <div class="flex border-white justify-between">
      <h2 class="text-2xl mild-text-shadow tracking-[.22rem] pl-1">
        games.television.film
      </h2>
      <div class="flex gap-5 items-end">
        <button
          id="nav-toggle"
          class="h-full font-bold cursor-pointer hover:opacity-80 transition-opacity hamburger"
          aria-label="Open navigation"
          type="button">=</button
        >
      </div>
    </div>
    <nav id="main-nav" class="nav-container">
      <div class="flex-1 bottom-left-bevel router-link-container">
        <HomepageRouterLink
          text="Dashboard"
          hint="At-a-glance stats"
          path="/home/"
        />
        <HomepageRouterLink
          text="Your Collections"
          hint="Create, browse, & organize your media"
          path="/collections/"
        />
        <HomepageRouterLink
          text="Import Tools"
          hint="Bring a collection from elsewhere"
          path="/import"
        />
        <HomepageRouterLink
          text="Export Tools"
          hint="Take your collections to-go"
          path="/export/"
        />
      </div>
    </nav>
  </div>
  <img
    src="/dithered-dorfic-clouds.png"
    alt="Background image"
    class="antialiased small-tr-big-bl-bevel p-1 dorfic-cloud-banner"
    style="object-fit: cover; image-rendering: pixelated;"
  />
</header>

<script>
  const btn = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");

  btn?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("nav-container-expanded");
    if (btn) {
      btn.textContent = isOpen ? "×" : "=";
      btn.setAttribute(
        "aria-label",
        isOpen ? "Close navigation" : "Open navigation",
      );
      btn.classList.toggle("hamburger-active", isOpen);
    }
  });
</script>

<style lang="scss">
  header {
    color: #ededed;
    padding-top: 5px;
  }

  .dorfic-cloud-banner {
    background: linear-gradient(
      0deg,
      rgb(247, 129, 83) 0%,
      rgba(252, 121, 69, 1) 10%
    );
  }

  .user-container {
    cursor: pointer;
  }

  .username {
    white-space: nowrap;
  }

  .user-avatar {
    white-space: nowrap;
    text-align: right;
    display: inline-block;
    position: relative;
    right: 0;
    filter: invert(1);
  }

  #nav-toggle {
    font-size: 18px;
  }

  .router-link-container {
    overflow: hidden;
    border: none;
    z-index: 100;
  }

  .nav-container {
    max-height: 0;
    overflow: hidden;
    transition-property: max-height, outline;
    transition-duration: 0.25s;
    transition-timing-function: ease;
    transition-delay: 0, 0.5s;
    outline: 1px solid transparent;
  }

  .nav-container-expanded {
    max-height: 500px;
    overflow: visible;
    outline: 1px solid white;
  }

  .title-bar-container {
    overflow: hidden;
    background: linear-gradient(
      0deg,
      rgb(247, 129, 83) 0%,
      rgba(252, 121, 69, 1) 10%
    );
  }

  .hamburger {
    background: transparent;
    transition: all 0.3s ease;
    width: 30px;

    &:hover {
      background: rgba(255, 255, 255, 0.8);
      color: black;
    }
  }

  .hamburger-active {
    background: white;
    color: black;

    &:hover {
      background: rgba(255, 255, 255, 0.8);
    }
  }
</style>
