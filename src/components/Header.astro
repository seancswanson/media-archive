---
import HomepageRouterLink from "./HomepageRouterLink.astro";

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<header id={id}>
  <div class="relative mb-2 p-[1px]">
    <img
      src="/dithered-dorfic-clouds.png"
      alt="Background image"
      class="antialiased big-tr-bl-bevel p-1 dorfic-cloud"
      style="object-fit: cover; image-rendering: pixelated;"
    />
  </div>
  <div
    class="flex flex-col justify-between border-white border small-tr-big-bl-bevel title-bar-container"
  >
    <div class="flex border-white justify-between items-start">
      <h1 class="text-4xl font-bold mild-text-shadow pl-1">Media Archive</h1>
      <div
        class="flex gap-2 items-center small-bl-bevel user-container basis-16 hover:basis-48 hover:pl-6 min-h-[25px]"
      >
        <div class="h-5 w-5 bg-white rounded-full user-info-container"></div>
        <div class="username">Log In</div>
      </div>
    </div>
    <div class="flex border-white justify-between">
      <h2 class="text-2xl mild-text-shadow tracking-[.22rem] pl-1">
        games.television.film
      </h2>
      <div class="flex gap-5 items-end">
        <button
          id="nav-toggle"
          class="h-full font-bold cursor-pointer hover:opacity-80 transition-opacity hamburger"
          aria-label="Open navigation"
          type="button">=</button
        >
      </div>
    </div>
  </div>

  <nav id="main-nav" class="nav-container">
    <div class="flex-1 bottom-left-bevel router-link-container ml-auto w-[98%]">
      <HomepageRouterLink
        text="Your Collections"
        hint="Create, browse, & organize your media"
        path="/collections/"
      />
      <HomepageRouterLink
        text="Import Tools"
        hint="Bring a collection from elsewhere"
        path="/import"
      />
      <HomepageRouterLink
        text="Export Tools"
        hint="Take your collections to-go"
        path="/export/"
      />
    </div>
    <div class="flex justify-end border-white p-2">
      <a
        href="/"
        class="text-xl border px-2 rounded-4xl hover:bg-white hover:text-[#ff7f00] transition text-shadow-gray-950 tracking-wide"
        >Log In</a
      >
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");

  btn?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("nav-container-expanded");
    if (btn) {
      btn.textContent = isOpen ? "×" : "=";
      btn.setAttribute(
        "aria-label",
        isOpen ? "Close navigation" : "Open navigation",
      );
      btn.classList.toggle("hamburger-active", isOpen);
    }
  });
</script>

<style lang="scss">
  header {
    color: #ededed;
  }

  .dorfic-cloud {
    background: linear-gradient(
      0deg,
      rgb(247, 129, 83) 0%,
      rgba(252, 121, 69, 1) 10%
    );
  }

  .user-container {
    transition: all 0.2s ease;
    justify-content: center;
    cursor: pointer;

    &:hover {
      justify-content: start;
    }

    &:hover .username {
      display: block;
    }
  }

  .username {
    display: none;
    width: 0;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .user-info-container {
    white-space: nowrap;
    text-align: right;
    display: inline-block;
    position: relative;
    right: 0;
  }

  #nav-toggle {
    font-size: 18px;
  }

  .router-link-container {
    overflow: hidden;
  }
  .nav-container {
    max-height: 0;
    overflow: hidden;
    transition-property: max-height, border-top;
    transition-duration: 0.25s;
    transition-timing-function: ease;
    transition-delay: 0, 0.5s;
  }

  .nav-container-expanded {
    max-height: 500px;
    overflow: visible;
  }

  .title-bar-container {
    background: linear-gradient(
      0deg,
      rgb(247, 129, 83) 0%,
      rgba(252, 121, 69, 1) 10%
    );
  }

  .hamburger {
    background: transparent;
    transition: all 0.3s ease;
    width: 60px;

    &:hover {
      background: rgba(255, 255, 255, 0.8);
      color: black;
    }
  }

  .hamburger-active {
    background: white;
    color: black;

    &:hover {
      background: rgba(255, 255, 255, 0.8);
    }
  }
</style>
