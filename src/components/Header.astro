---
import HomepageRouterLink from "./HomepageRouterLink.astro";

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<header id={id}>
  <div class="relative min-h-42 mb-2 small-tr-bevel bg-[#ff7f00] p-1">
    <img
      src="/dithered-dorfic-clouds.png"
      alt="Background image"
      class="antialiased big-tr-bl-bevel p-1"
      style="object-fit: cover; image-rendering: pixelated; position: absolute; inset: 0; width: 100%; height: 100%;"
    />
  </div>
  <div
    class="flex flex-col justify-between border-white border small-tr-bevel title-bar-container"
  >
    <div class="flex border-white justify-between items-start">
      <h1 class="text-6xl font-bold mild-text-shadow pl-1">Media Archive</h1>
      <div
        class="flex gap-2 items-center small-bl-bevel user-container basis-16 hover:basis-48 hover:pl-6 min-h-[25px]"
      >
        <div class="h-5 w-5 bg-white rounded-full user-info-container"></div>
        <div class="username">Login</div>
      </div>
    </div>
    <div class="flex border-white justify-between">
      <h2 class="text-3xl mild-text-shadow tracking-[.22rem] pl-1">
        games.television.film
      </h2>
      <div class="flex gap-5 items-center">
        <button
          id="nav-toggle"
          class="text-3xl font-bold cursor-pointer hover:opacity-80 transition-opacity hamburger"
          aria-label="Open navigation"
          type="button">=</button
        >
      </div>
    </div>
  </div>

  <nav id="main-nav" class="nav-container">
    <div class="flex-1 bottom-left-bevel router-link-container">
      <HomepageRouterLink
        text="Your Collections"
        hint="Create, browse, & organize your media"
        path="/collections/"
      />
      <HomepageRouterLink
        text="Import Tools"
        hint="Bring a collection from elsewhere"
        path="/import"
      />
      <HomepageRouterLink
        text="Export Tools"
        hint="Take your collections to-go"
        path="/export/"
      />
    </div>
    <div class="flex place-self-center flex-1 items-center border-white px-2">
      <a
        href="/"
        class="text-xl border px-2 rounded-4xl hover:bg-white hover:text-[#ff7f00] transition text-shadow-gray-950 tracking-wide"
        >Log In</a
      >
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");

  btn?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("nav-container-expanded");
    if (btn) {
      btn.textContent = isOpen ? "×" : "=";
      btn.setAttribute(
        "aria-label",
        isOpen ? "Close navigation" : "Open navigation",
      );
      btn.classList.toggle("hamburger-active", isOpen);
    }
  });
</script>

<style lang="scss">
  header {
    color: #ededed;
  }

  .user-container {
    transition: all 0.2s ease;
    justify-content: center;
    cursor: pointer;

    &:hover {
      justify-content: start;
    }

    &:hover .username {
      display: block;
    }
  }

  .username {
    display: none;
    width: 0;
    transition: all 0.2s ease;
  }

  .user-info-container {
    text-align: right;
    white-space: nowrap;
    display: inline-block;
    position: relative;
    right: 0;
  }

  .big-tr-bl-bevel {
    border-bottom: 1px solid #ededed;
    border-top: 1px solid #ededed;
    border-left: 1px solid #ededed;
    border-right: 1px solid #ededed;
    border-radius: 0 3rem 0 3rem;
    corner-shape: bevel;
  }

  .small-bl-bevel {
    border-bottom: 1px solid #ededed;
    border-left: 1px solid #ededed;
    border-radius: 0 0 0 1.5rem;
    corner-shape: bevel;
  }

  .small-tr-bl-bevel {
    border-bottom: 1px solid #ededed;
    border-top: 1px solid #ededed;
    border-left: 1px solid #ededed;
    border-right: 1px solid #ededed;
    border-radius: 0 1.5rem 0 1.5rem;
    corner-shape: bevel;
  }

  .small-tr-bevel {
    border-bottom: 1px solid #ededed;
    border-top: 1px solid #ededed;
    border-left: 1px solid #ededed;
    border-right: 1px solid #ededed;
    border-radius: 0 1.5rem 0 0rem;
    corner-shape: bevel;
  }

  .big-tl-br-bevel {
    border-bottom: 1px solid #ededed;
    border-top: 1px solid #ededed;
    border-left: 1px solid #ededed;
    border-right: 1px solid #ededed;
    border-radius: 3rem 0 3rem 0;
    corner-shape: bevel;
  }

  .small-tl-br-bevel {
    border-bottom: 1px solid #ededed;
    border-top: 1px solid #ededed;
    border-left: 1px solid #ededed;
    border-right: 1px solid #ededed;
    border-radius: 1.5rem 0 1.5rem 0;
    corner-shape: bevel;
  }

  .nav-container {
    max-height: 0;
    overflow: hidden;
    transition-property: max-height, border-top;
    transition-duration: 0.25s;
    transition-timing-function: ease;
    transition-delay: 0, 0.5s;
  }

  .nav-container-expanded {
    max-height: 500px;
    overflow: visible;
  }

  .title-bar-container {
    background: #ffffff;
    background: linear-gradient(
      178deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(0, 0, 0, 0.025) 100%
    );
  }

  .hamburger {
    background: transparent;
    transition: all 0.3s ease;
    width: 40px;

    &:hover {
      background: rgba(255, 255, 255, 0.8);
      color: black;
    }
  }

  .hamburger-active {
    background: white;
    color: black;

    &:hover {
      background: rgba(255, 255, 255, 0.8);
    }
  }
</style>
