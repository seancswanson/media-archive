---
interface Props {
  text: string;
  hint: string;
  path: string;
}

const { text, hint, path } = Astro.props;
---

<a href={path} class="homepage-router-link heavy-text-shadow">
  <h2 class="homepage-router-link-title">{text}</h2>
  <p class="homepage-router-link-hint">{hint}</p>
</a>

<style lang="scss">
  .homepage-router-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid;
    padding: 0.5rem;
    padding-bottom: 0;
    padding-top: 0.8rem;
    flex: 1;
    transition: all 0.3s ease;
    background: linear-gradient(
      0deg,
      rgb(247, 129, 83) 0%,
      rgba(252, 121, 69, 1) 10%
    );

    &:last-of-type {
      border-bottom: 0px solid;
    }

    &:hover {
      border-inline: 30px solid white;
      background: linear-gradient(
        0deg,
        rgb(247, 129, 83) 50%,
        hsl(17, 97%, 70%) 90%
      );
    }
  }

  .homepage-router-link-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .homepage-router-link-hint {
    font-size: 0.8rem;
    text-align: right;
  }
</style>
